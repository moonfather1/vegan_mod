{
	"schemaVersion": 1,
	"id": "vegan_mod",
	"version": "${version}",
	"name": "I dont want to kill them!!",
	"description": "Vegan and family-friendly solutions for leather, feathers, ink sacs, etc. You no longer need to slaughter cows/rabbits/etc. to make something as mundane as book and quill.",
	"authors": [ "MoonFather" ],
	"contact": {
		"homepage": "https://modrinth.com/mod/i-dont-want-to-kill-them",
		"sources": "https://github.com/moonfather1/vegan_mod/",
		"issues": "https://discord.gg/2VayYKktvx"
	},
	"license": "MLL",
	"icon": "assets/vegan_mod/icon.png",
	"environment": "*",
	"entrypoints": {
          "main": [
            "moonfather.vegan_mod.VeganMod"
          ],
          "client": [
            "moonfather.vegan_mod.ClientEntryPoint"
          ],
          "jei_mod_plugin": [
            "moonfather.vegan_mod.integration.JeiRegistration"
          ],
          "rei_client": [
            "moonfather.vegan_mod.integration.ReiRegistration"
          ],
          "rrv": [
            "moonfather.vegan_mod.integration.RrvServerPlugin"
          ],
          "rrv_client": [
            "moonfather.vegan_mod.integration.RrvClientPlugin"
          ],
          "jade": [
            "moonfather.vegan_mod.integration.JadeServerPlugin",
            "moonfather.vegan_mod.integration.JadeClientPlugin"
          ]
    },
	"mixins": [
		"vegan_mod.mixins.json",
		{
			"config": "vegan_mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
                "forgeconfigapiport": "*",
		"fabric-api": "*"
	}
}